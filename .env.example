# Public site URL (used for canonical, sitemap, and robots)
NEXT_PUBLIC_SITE_URL=https://textfromvideos.com

# Postgres connection string. Leave empty for a temporary in-memory cache
# (not durable; not safe for production). Apply db/schema.sql when ready.
DATABASE_URL=

# ASR provider: deepgram | assemblyai | openai
# Default is deepgram. Use openai only after the Whisper bake-off and credits are added.
ASR_PROVIDER=deepgram

# Shared fallback key used if a provider-specific key is missing.
ASR_API_KEY=

# Provider-specific keys (preferred over ASR_API_KEY)
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=

# Optional model overrides
# DEEPGRAM_MODEL=nova-3
# OPENAI_WHISPER_MODEL=whisper-1

# Optional paths if the binaries are not on PATH
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Optional Netscape cookies file for Instagram (and some TikTok) fetches.
# Locally, point at a gitignored file. In production, set the Worker secret
# YTDLP_COOKIES_B64 to the base64 of that file; the container writes it to
# /tmp/tiktok-cookies.txt on start. Do not commit cookie files.
# YTDLP_COOKIES_FILE=
# YTDLP_COOKIES_B64=

# Optional analytics hooks. Leave empty until you have an ID / domain.
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXX
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=textfromvideos.com
